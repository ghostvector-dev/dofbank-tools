# .env.example — DofBank Migration Tool
# Copy this file to .env and fill in your credentials
# !! Never commit .env to version control !!

# ── Source: Oracle Legacy ──────────────────────────────────
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SID=DOFBANKPROD
ORACLE_USER=
ORACLE_PASS=

# ── Target: PostgreSQL New ─────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_NAME=dofbank_v2
PG_USER=
PG_PASS=

# ── Migration Settings ─────────────────────────────────────
BATCH_SIZE=500
DRY_RUN=true
LOG_LEVEL=INFO
LOG_FILE=./logs/migration.log

# ── Notifications (optional) ───────────────────────────────
SLACK_WEBHOOK=
NOTIFY_EMAIL=
